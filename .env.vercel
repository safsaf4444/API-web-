# ==========================================
# VERCEL DEPLOYMENT ENVIRONMENT VARIABLES
# ==========================================
# Copy these values into your Vercel Project > Settings > Environment Variables

# 1. Database Connection URL
# Vercel serverless functions are read-only, so a local sqlite file will crash.
# You MUST use a hosted Postgres database (e.g., Supabase, Neon, AWS RDS).
DATABASE_URL=postgresql://user:password@hostname:5432/dbname

# 2. CORS Allowed Origins
# The URL where your frontend will be accessed from.
# Vercel will automatically provide branch URLs, but you should explicitly allow
# your main production domain here.
CORS_ALLOW_ORIGINS=https://your-production-app.vercel.app

# 3. Environment Name
# Set to 'production' to enforce stricter security checks in the app.
ENV=production

# 4. Secret Key
# Used for securely signing JWTs or sessions. 
# Generate a random string using `openssl rand -hex 32`
SECRET_KEY=your_super_secret_production_key_here
