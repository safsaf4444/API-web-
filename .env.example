# ── Core ──────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here

APP_ENV=production

# ── Database ──────────────────────────────────────────────────
# Railway auto-sets this when you add a Postgres plugin.
# Leave blank for SQLite (local dev only).
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── BYOK Encryption ───────────────────────────────────────────
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AI_ENCRYPTION_KEY=your-fernet-key-here

# ── Free AI tier (optional but recommended) ───────────────────
GEMINI_API_KEY=your-gemini-api-key-here
GROQ_API_KEY=your-groq-api-key-here

# ── CORS ──────────────────────────────────────────────────────
# Set to your Railway frontend URL in production, or * for open
CORS_ALLOW_ORIGINS=*

# ── Rate limiting ─────────────────────────────────────────────
RATE_LIMIT_ENABLED=true

# ── AI model config (optional) ────────────────────────────────
OPENAI_MODEL=gpt-4o-mini
GEMINI_FREE_DAILY_LIMIT=20
GROQ_FREE_DAILY_LIMIT=30
